<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!--
        The encrypted prefs file is excluded from both paths. Its master key lives in the
        hardware keystore and does not transfer, so a restored copy would be undecryptable
        anyway — and cloud-backing credentials is undesirable regardless.
        File name matches SecurePreference.FILE_NAME; keep the two in sync.
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_compose_base_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_compose_base_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>